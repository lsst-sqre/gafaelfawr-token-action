{
  "name": "gafaelfawr-token-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that obtains a Gafaelfawr token through GitHub Actions OIDC token exchange",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "esbuild-plugin-license": "^1.2.3",
    "msw": "^2.15.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "msw"
    ]
  }
}
